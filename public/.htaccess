# ── asensios.com · Apache / LiteSpeed (Hostinger) ───────────────────────────
#
# Canonical routes: /  ·  /trajectory  ·  /games
# There is deliberately NO catch-all rewrite to index.html — an unknown URL
# must 404, not quietly render the homepage.

# ── Legacy routes ───────────────────────────────────────────────────────────
# Anchored patterns so /trajectory itself is never caught (that would loop).
RedirectMatch 301 ^/trajectory\.html$ /trajectory/
RedirectMatch 301 ^/business/?$ /trajectory/

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Existing file or directory wins, untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Extensionless routes resolve to their index.html.
  RewriteRule ^trajectory/?$ /trajectory/index.html [L]
  RewriteRule ^games/?$      /games/index.html      [L]
</IfModule>

DirectoryIndex index.html

# ── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Caching ─────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  # HTML always revalidates so a new deploy shows up immediately.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
